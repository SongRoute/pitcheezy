{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"json": {"()": "observer_app.logs.JsonFormatter"}},
  "handlers": {"stderr": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stderr"}},
  "root": {"level": "INFO", "handlers": ["stderr"]},
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": ["stderr"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["stderr"], "propagate": false},
    "uvicorn.access": {"level": "WARNING", "handlers": ["stderr"], "propagate": false}
  }
}
