        "isolates": "adding_batter_identity_to_pitcher_identity",
        "role": "primary",
        "parameter_matched": false,
        "compute_matched": false,
        "information_free_capacity_control": "see batter_id_vs_row_shuffle (batter path only)"
      },
      {
        "name": "pitcher_batter_id_vs_batter_id",
        "candidate": "pitcher_batter_id_periodic_residual_counts",
