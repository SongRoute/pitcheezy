# Public (static-mode) bundle defaults, loaded by `npm run build:public` (vite --mode public).
# A variable set in the shell wins over this file. No secrets here: everything below ends up in the public bundle.

# Where the published files live: URL or path prefix that holds `v1/`. `.` = next to index.html (same hosting prefix).
VITE_PUBLISH_BASE=.

# Fallback polling cadence, milliseconds. manifest.publish_interval_s overrides these.
VITE_PUBLISH_POLL_MS=10000
VITE_PUBLISH_PREGAME_POLL_MS=10000
VITE_PUBLISH_RETRY_MS=4000

# PROVISIONAL (not measured): seconds without a new publish before the screen says "갱신 지연".
# Placeholder = the screen's existing 30 s late-connection figure. Set from rehearsal measurements of publish interval + hosting delay.
VITE_PUBLISH_STALE_S=30

# List screen: how often the shown date's list (and health.json) is read again. Same value as the pregame cadence.
VITE_PUBLISH_LIST_POLL_MS=10000
# One request may take this long, headers and body together. Same value as the API-mode screen.
VITE_PUBLISH_TIMEOUT_MS=15000
# No successful read for this long while following a game = "연결 끊김". Same value as the API-mode screen.
VITE_PUBLISH_LOST_MS=30000
# How often the screen re-evaluates its time-based notices between reads.
VITE_PUBLISH_TICK_MS=5000
# VITE_PUBLISH_LOST_MS and VITE_PUBLISH_STALE_S are never applied shorter than 3 poll intervals of the screen in question.
# dates.json and manifest.json are re-read every max(60 seconds, manifest interval).
# PROVISIONAL (not measured): a game with no published file yet is asked again after this long, doubling up to the max;
# asking stops when no list of a followed date names the game.
VITE_PUBLISH_MISSING_RETRY_MS=10000
VITE_PUBLISH_MISSING_MAX_MS=60000
# PROVISIONAL (not measured): a screen pinned on a past pitch still checks at this fallback interval,
# so a pitch the server turns back to 확인 중 is blanked there too. Default = the pregame cadence.
VITE_PUBLISH_PINNED_POLL_MS=10000
