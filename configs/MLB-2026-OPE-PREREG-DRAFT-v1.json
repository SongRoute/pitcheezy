        "both_policy_ESS_gates_pass (PA>=100, game>=30)",
        "bootstrap_invalid_share <= 0.05",
        "no_integrity_failure_and_paired_identity_run_exact_zero"
      ],
      "IMPROVEMENT_SUPPORTED_implies_STATISTICAL": true,
      "bias_bound_b_V": {
        "definition": "b_V := |delta_gap_V2| + 1.96 * delta_gap_se_V2",
        "source": "sealed le2025 S5 v2.json, check=V2 law=pi_b_hat runs",
        "seeds": "seeds.planning_v2 = [0,1,2] (includes planning_main = 0); use max b_V over seeds",
