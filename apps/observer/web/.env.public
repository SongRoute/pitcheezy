# Public (static-mode) bundle defaults, loaded by `npm run build:public` (vite --mode public).
# A variable set in the shell wins over this file. No secrets here: everything below ends up in the public bundle.

# Where the published files live: URL or path prefix that holds `v1/`. `.` = next to index.html (same hosting prefix).
VITE_PUBLISH_BASE=.

# Polling cadence, milliseconds. Same values as the API-mode screen.
VITE_PUBLISH_POLL_MS=2000
VITE_PUBLISH_PREGAME_POLL_MS=10000
VITE_PUBLISH_RETRY_MS=4000

# PROVISIONAL (not measured): seconds without a new publish before the screen says "갱신 지연".
# Placeholder = the screen's existing 30 s late-connection figure. Set from rehearsal measurements of publish interval + hosting delay.
VITE_PUBLISH_STALE_S=30
