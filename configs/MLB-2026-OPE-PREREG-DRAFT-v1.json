  "success_criteria": {
    "status": "proposal_preregistered_before_le2025_S6_read",
    "written": "2026-09-30",
    "primary_estimand": "L1 (E0 start population) Delta = V(pi_cand) - V(pi_ref), defense WE per PA, paired per PA; interval [Delta_lo, Delta_hi] from censored-node bounds",
    "decision_rule": {
      "IMPROVEMENT_SUPPORTED_STATISTICAL": [
        "game_bootstrap_95ci_lower_of_Delta_lo > minimum_effect (0.001)",
