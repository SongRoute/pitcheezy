{
  "name": "pitcheezy-observer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public --outDir dist-public",
    "build:v3": "tsc -b && vite build --mode v3 --outDir dist-v3",
    "build:preview": "tsc -b && vite build --mode preview --outDir dist-preview",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "playwright": "^1.63.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
