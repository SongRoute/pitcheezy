# Public static-mode bundle with the v3 screens (npm run build:v3). Same publish settings as .env.public; only the screen set differs.
# No secrets here: everything below ends up in the public bundle.
VITE_PUBLISH_BASE=.
VITE_UI=v3
VITE_PUBLISH_POLL_MS=2000
VITE_PUBLISH_PREGAME_POLL_MS=10000
VITE_PUBLISH_RETRY_MS=4000
VITE_PUBLISH_STALE_S=30
VITE_PUBLISH_LIST_POLL_MS=10000
VITE_PUBLISH_TIMEOUT_MS=15000
VITE_PUBLISH_LOST_MS=30000
VITE_PUBLISH_TICK_MS=5000
VITE_PUBLISH_DATES_POLL_MS=10000
VITE_PUBLISH_MISSING_RETRY_MS=10000
VITE_PUBLISH_MISSING_MAX_MS=60000
VITE_PUBLISH_PINNED_POLL_MS=10000
# v3 presets (see src/v3/options.ts). Values: zone A|B|C, list row|stack|side, stats table|card, density full|lite, view catcher|pitcher.
VITE_V3_ZONE=B
VITE_V3_LIST=row
VITE_V3_STATS=card
VITE_V3_DENSITY=lite
VITE_V3_VIEW=catcher
# World Series strip on the list: the two teams as published abbreviations (e.g. LAD,NYY). Empty = off.
VITE_V3_SERIES_FROM=
VITE_V3_SERIES_TEAMS=
VITE_V3_SERIES_TITLE=월드시리즈
