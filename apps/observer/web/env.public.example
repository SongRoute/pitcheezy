# Copy to `.env.public` (gitignored) before `npm run build:public`.
# VITE_PUBLISH_BASE is where the published watch files live, relative to index.html ("." = same folder).
# Timing values are milliseconds/seconds; uncomment to override the defaults in src/service/publish.ts.
VITE_PUBLISH_BASE=.
# VITE_PUBLISH_POLL_MS=
# VITE_PUBLISH_PREGAME_POLL_MS=
# VITE_PUBLISH_PINNED_POLL_MS=
# VITE_PUBLISH_LIST_POLL_MS=
# VITE_PUBLISH_TICK_MS=
# VITE_PUBLISH_TIMEOUT_MS=
# VITE_PUBLISH_RETRY_MS=
# VITE_PUBLISH_MISSING_RETRY_MS=
# VITE_PUBLISH_MISSING_MAX_MS=
# VITE_PUBLISH_LOST_MS=
# VITE_PUBLISH_STALE_S=
